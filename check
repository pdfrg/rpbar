#!/bin/bash
# rpbar check: format, lint, pure-logic tests. Run before every commit.
set -euo pipefail
cd "$(dirname "$0")"

qmlformat -i BarWidget.qml Service.qml
qmllint -I "$OMARCHY_PATH/shell" BarWidget.qml Service.qml
node --check RpLogic.js
node --input-type=module -e "
import fs from 'fs';
import assert from 'node:assert/strict';
const src = fs.readFileSync('RpLogic.js', 'utf8');
const Rp = new Function(src + '; return {stations,stationByChan,stepChan,streamUrl,splitArtistTitle,sanitizeText,notifySafe,coverId,isAllowedImageUrl,defaultQuality,stationShort,pillText};')();
assert.equal(Rp.stations().length, 7);
assert.equal(Rp.streamUrl(0), 'https://stream.radioparadise.com/aac-128');
assert.equal(Rp.streamUrl(1), 'https://stream.radioparadise.com/mellow-128');
assert.equal(Rp.streamUrl(42), 'https://stream.radioparadise.com/serenity');
assert.equal(Rp.streamUrl(945), 'https://stream.radioparadise.com/kfat-128');
assert.deepEqual(Rp.splitArtistTitle('A - T'), {artist: 'A', title: 'T'});
assert.deepEqual(Rp.splitArtistTitle('Solo'), {artist: '', title: 'Solo'});
assert.equal(Rp.sanitizeText(String.fromCharCode(97, 0, 98, 8238, 99)), 'abc');
assert.equal(Rp.notifySafe('a<b>i</b> -> c', 64), 'ab>i/b> -> c');
assert.equal(Rp.coverId('https://img.radioparadise.com/covers/m/11697.jpg'), '11697');
assert.equal(Rp.coverId('https://img.radioparadise.com/covers/s/1.jpg'), '1');
assert.equal(Rp.coverId('https://evil.com/covers/m/11697.jpg'), '');
assert.equal(Rp.coverId('https://img.radioparadise.com/covers/m/../x.jpg'), '');
assert.equal(Rp.stepChan(0, 1), 1);
assert.equal(Rp.stepChan(945, 1), 0);
assert.equal(Rp.stepChan(0, -1), 945);
assert.equal(Rp.stepChan(999, 1), 0);
assert.equal(Rp.stationShort(0), 'MM');
assert.equal(Rp.stationShort(1), 'ML');
assert.equal(Rp.stationShort(2), 'R');
assert.equal(Rp.stationShort(3), 'G');
assert.equal(Rp.stationShort(5), 'B');
assert.equal(Rp.stationShort(42), 'S');
assert.equal(Rp.stationShort(945), 'K');
assert.equal(Rp.stationShort(999), 'RP');
assert.equal(Rp.pillText(0, 'Talk Talk', 'Eden'), 'MM: Talk Talk - Eden');
assert.equal(Rp.pillText(1, '', 'Solo'), 'ML: Solo');
assert.equal(Rp.pillText(0, '', ''), 'The Main Mix');
assert.equal(Rp.isAllowedImageUrl('https://img.radioparadise.com/covers/l/1.jpg'), true);
assert.equal(Rp.isAllowedImageUrl('http://img.radioparadise.com/x.jpg'), false);
assert.equal(Rp.isAllowedImageUrl('https://img.radioparadise.com.evil.com/x'), false);
console.log('RpLogic tests ok');
"
echo "check ok"
