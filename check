#!/bin/bash
# rpbar check: format, lint, pure-logic tests. Run before every commit.
set -euo pipefail
cd "$(dirname "$0")"

qmlformat -i BarWidget.qml Service.qml TrackRow.qml
qmllint -I "$OMARCHY_PATH/shell" BarWidget.qml Service.qml TrackRow.qml
node --check RpLogic.js
node --input-type=module -e "
import fs from 'fs';
import assert from 'node:assert/strict';
const src = fs.readFileSync('RpLogic.js', 'utf8');
const Rp = new Function(src + '; return {stations,stationByChan,stepChan,streamUrl,splitArtistTitle,sanitizeText,notifySafe,coverId,isAllowedImageUrl,defaultQuality,stationShort,pillText,qualitiesFor,defaultQualityFor,qualityOrDefault,qualityNote,playerPageUrl,isAllowedLinkUrl,resolveCoverUrl,scheduleEntry,entryKey,parseBlock,splitSchedule,parsePlaylist,formatRating,formatIn,formatAgo,toastLines,clampVolume,volumeFor,qualityForStation,largeCoverUrl,largeArtTmpPath,sleepLabel,sleepMins};')();
assert.equal(Rp.stations().length, 7);
assert.equal(Rp.streamUrl(0), 'https://stream.radioparadise.com/aac-128');
assert.equal(Rp.streamUrl(1), 'https://stream.radioparadise.com/mellow-128');
assert.equal(Rp.streamUrl(42), 'https://stream.radioparadise.com/serenity');
assert.equal(Rp.streamUrl(945), 'https://stream.radioparadise.com/kfat-128');
assert.deepEqual(Rp.splitArtistTitle('A - T'), {artist: 'A', title: 'T'});
assert.deepEqual(Rp.splitArtistTitle('Solo'), {artist: '', title: 'Solo'});
assert.equal(Rp.sanitizeText(String.fromCharCode(97, 0, 98, 8238, 99)), 'abc');
assert.equal(Rp.notifySafe('a<b>i</b> -> c', 64), 'ab>i/b> -> c');
assert.equal(Rp.coverId('https://img.radioparadise.com/covers/m/11697.jpg'), '11697');
assert.equal(Rp.coverId('https://img.radioparadise.com/covers/s/1.jpg'), '1');
assert.equal(Rp.coverId('https://evil.com/covers/m/11697.jpg'), '');
assert.equal(Rp.coverId('https://img.radioparadise.com/covers/m/../x.jpg'), '');
assert.equal(Rp.stepChan(0, 1), 1);
assert.equal(Rp.stepChan(945, 1), 0);
assert.equal(Rp.stepChan(0, -1), 945);
assert.equal(Rp.stepChan(999, 1), 0);
assert.equal(Rp.stationShort(0), 'MM');
assert.equal(Rp.stationShort(1), 'ML');
assert.equal(Rp.stationShort(2), 'R');
assert.equal(Rp.stationShort(3), 'G');
assert.equal(Rp.stationShort(5), 'B');
assert.equal(Rp.stationShort(42), 'S');
assert.equal(Rp.stationShort(945), 'K');
assert.equal(Rp.stationShort(999), 'RP');
assert.equal(Rp.pillText(0, 'Talk Talk', 'Eden'), 'MM: Talk Talk - Eden');
assert.equal(Rp.pillText(1, '', 'Solo'), 'ML: Solo');
assert.equal(Rp.pillText(0, '', ''), 'The Main Mix');
assert.equal(Rp.qualitiesFor(0).length, 4);
assert.equal(Rp.qualitiesFor(1).length, 4);
assert.equal(Rp.qualitiesFor(42).length, 2);
assert.equal(Rp.defaultQualityFor(42), 'aac-64');
assert.equal(Rp.defaultQualityFor(0), 'aac-128');
assert.equal(Rp.qualityOrDefault(0, 'aac-320'), 'aac-320');
assert.equal(Rp.qualityOrDefault(42, 'aac-320'), 'aac-64');
assert.equal(Rp.qualityOrDefault(1, 'bogus'), 'aac-128');
assert.equal(Rp.streamUrl(0, 'aac-320'), 'https://stream.radioparadise.com/aac-320');
assert.equal(Rp.streamUrl(0, 'mp3-192'), 'https://stream.radioparadise.com/mp3-192');
assert.equal(Rp.streamUrl(0, 'flacm'), 'https://stream.radioparadise.com/flacm');
assert.equal(Rp.streamUrl(1, 'aac-320'), 'https://stream.radioparadise.com/mellow-320');
assert.equal(Rp.streamUrl(1, 'mp3-192'), 'https://stream.radioparadise.com/mellow-192');
assert.equal(Rp.streamUrl(1, 'flacm'), 'https://stream.radioparadise.com/mellow-flacm');
assert.equal(Rp.streamUrl(42, 'flac'), 'https://stream.radioparadise.com/serenity-flac');
assert.equal(Rp.streamUrl(42, 'aac-320'), 'https://stream.radioparadise.com/serenity');
assert.equal(Rp.qualityNote(42), 'Serenity offers 64k AAC and FLAC only.');
assert.equal(Rp.qualityNote(0), 'FLAC+ carries track titles; plain FLAC is not offered.');
assert.equal(Rp.playerPageUrl(0), 'https://radioparadise.com/player/info/main-mix');
assert.equal(Rp.playerPageUrl(1), 'https://radioparadise.com/player/info/mellow');
assert.equal(Rp.playerPageUrl(2), 'https://radioparadise.com/player/info/rock');
assert.equal(Rp.playerPageUrl(3), 'https://radioparadise.com/player/info/global');
assert.equal(Rp.playerPageUrl(5), 'https://radioparadise.com/player/info/beyond');
assert.equal(Rp.playerPageUrl(42), 'https://radioparadise.com/player/info/serenity');
assert.equal(Rp.playerPageUrl(945), 'https://radioparadise.com/player/info/kfat');
assert.equal(Rp.playerPageUrl(999), 'https://radioparadise.com/player/info/main-mix');
assert.equal(Rp.isAllowedLinkUrl('https://radioparadise.com/player/info/rock'), true);
assert.equal(Rp.isAllowedLinkUrl('https://www.radioparadise.com/player/info/rock'), true);
assert.equal(Rp.isAllowedLinkUrl('http://radioparadise.com/player/info/rock'), false);
assert.equal(Rp.isAllowedLinkUrl('https://radioparadise.com.evil.com/x'), false);
assert.equal(Rp.isAllowedLinkUrl('https://img.radioparadise.com/covers/m/1.jpg'), false);
assert.equal(Rp.isAllowedImageUrl('https://img.radioparadise.com/covers/l/1.jpg'), true);
assert.equal(Rp.isAllowedImageUrl('http://img.radioparadise.com/x.jpg'), false);
assert.equal(Rp.isAllowedImageUrl('https://img.radioparadise.com.evil.com/x'), false);
assert.equal(Rp.resolveCoverUrl('covers/m/2.jpg', '//img.radioparadise.com/'), 'https://img.radioparadise.com/covers/m/2.jpg');
assert.equal(Rp.resolveCoverUrl('covers/l/1.jpg', 'https://img.radioparadise.com/'), 'https://img.radioparadise.com/covers/l/1.jpg');
assert.equal(Rp.resolveCoverUrl('https://img.radioparadise.com/covers/m/1.jpg', ''), 'https://img.radioparadise.com/covers/m/1.jpg');
assert.equal(Rp.resolveCoverUrl('https://evil.com/x.jpg', ''), '');
assert.equal(Rp.resolveCoverUrl('http://img.radioparadise.com/x.jpg', ''), '');
assert.equal(Rp.resolveCoverUrl('foo/bar.jpg', 'https://img.radioparadise.com/'), '');
assert.equal(Rp.resolveCoverUrl('', ''), '');
const blockObj = { block_id: 1549, image_base: '//img.radioparadise.com/', song: {
  '0': { artist: 'A0', title: 'T0', album: 'AL0', year: '2020', cover_medium: 'covers/m/1.jpg', song_id: '10', sched_time_millis: 1000, duration: 200000, event: '100', rating: '6.5' },
  '1': { artist: 'A1', title: 'T1', album: 'AL1', year: '2021', cover_medium: 'covers/m/2.jpg', song_id: '11', sched_time_millis: 201000, duration: 200000, event: '101', rating: '7' },
  '2': { artist: 'A2', title: 'T2', album: 'AL2', year: '2022', cover_small: 'covers/s/3.jpg', song_id: '12', sched_time_millis: 401000, duration: 200000, event: '102' },
  '3': { artist: 'Evil', title: 'X', album: 'AL3', year: '2023', cover_medium: 'https://evil.com/x.jpg', song_id: '13', sched_time_millis: 601000, duration: 200000, event: '103' } } };
const pb = Rp.parseBlock(JSON.stringify(blockObj));
assert.equal(pb.blockId, '1549');
assert.equal(pb.items.length, 4);
assert.equal(pb.items[1].cover, 'https://img.radioparadise.com/covers/m/2.jpg');
assert.equal(pb.items[3].cover, '');
assert.equal(Rp.coverId(pb.items[1].cover), '2');
assert.equal(Rp.entryKey(pb.items[0]), 'A0\nT0');
assert.equal(pb.items[0].rating, '6.5');
assert.equal(pb.items[1].rating, '7.0');
assert.deepEqual(Rp.splitSchedule(pb.items, 'A1\nT1', 150000, 3).map((e) => e.title), ['T2', 'X']);
assert.deepEqual(Rp.splitSchedule(pb.items, 'Nobody\nNothing', 300000, 3).map((e) => e.title), ['T2', 'X']);
assert.equal(Rp.splitSchedule(pb.items, 'A0\nT0', 500, 2).length, 2);
assert.deepEqual(Rp.splitSchedule([], 'A\nT', 0, 3), []);
assert.deepEqual(Rp.parseBlock('garbage'), { blockId: '', items: [] });
assert.deepEqual(Rp.parseBlock('{\"song\":{}}'), { blockId: '', items: [] });
const listObj = { cover_base_url: 'https://img.radioparadise.com/', song: [
  { artist: 'A1', title: 'T1', album: 'AL1', year: '2021', cover_med: 'covers/m/2.jpg', song_id: '11', play_time: 201000, duration: 200000, event: '101', listener_rating: 6.2 },
  { artist: 'A0', title: 'T0', album: 'AL0', year: '2020', cover: 'covers/l/1.jpg', song_id: '10', play_time: 1000, duration: 200000, event: '100', listener_rating: 7 },
  { artist: 'Bad Bidi', title: 'T', album: '', year: '', cover_small: 'covers/s/9.jpg', song_id: '9', play_time: 500, duration: 1000, event: '99' } ] };
const pl = Rp.parsePlaylist(JSON.stringify(listObj), 'A1\nT1', 5);
assert.equal(pl.length, 2);
assert.equal(pl[0].title, 'T0');
assert.equal(pl[0].cover, 'https://img.radioparadise.com/covers/l/1.jpg');
assert.equal(pl[0].rating, '7.0');
assert.equal(pl[1].artist, 'BadBidi');
assert.deepEqual(Rp.parsePlaylist('nope', 'A\nT', 5), []);
assert.equal(Rp.formatRating('6.5'), '6.5');
assert.equal(Rp.formatRating('7'), '7.0');
assert.equal(Rp.formatRating(6.2), '6.2');
assert.equal(Rp.formatRating(''), '');
assert.equal(Rp.formatRating('—'), '');
assert.equal(Rp.formatRating('0'), '');
assert.equal(Rp.formatRating(undefined), '');
assert.deepEqual(Rp.toastLines('T', 'A', 'AL', '2020', '6.5'), ['T', 'A', 'AL (2020) · ★ 6.5']);
assert.deepEqual(Rp.toastLines('T', 'A', 'AL', '', '7.0'), ['T', 'A', 'AL · ★ 7.0']);
assert.deepEqual(Rp.toastLines('T', 'A', '', '', '6.5'), ['T', 'A · ★ 6.5']);
assert.deepEqual(Rp.toastLines('T', '', '', '', '6.5'), ['T · ★ 6.5']);
assert.deepEqual(Rp.toastLines('T', 'A', 'AL', '2020', ''), ['T', 'A', 'AL (2020)']);
assert.deepEqual(Rp.toastLines('T', '', '', '', ''), ['T']);
assert.deepEqual(Rp.toastLines('', 'A', 'AL', '2020', '6.5'), []);
assert.deepEqual(Rp.toastLines('A<B', 'A', 'AL', '2020', '6.5'), ['AB', 'A', 'AL (2020) · ★ 6.5']);
assert.ok(Rp.toastLines('T', 'A', 'AL', '2020', '6.5').length <= 3);
assert.equal(Rp.formatIn(150000 + 90 * 1000, 150000), 'in 1 min');
assert.equal(Rp.formatIn(150000 + 3700 * 1000, 150000), 'in 1 h 1 min');
assert.equal(Rp.formatIn(150000 + 7200 * 1000, 150000), 'in 2 h');
assert.equal(Rp.formatIn(150000 + 30 * 1000, 150000), 'starting soon');
assert.equal(Rp.formatIn(1000, 150000), 'now');
assert.equal(Rp.formatIn('', 150000), '');
assert.equal(Rp.formatAgo(1000, 200000, 1000 + 200000 + 155000), '2 min ago');
assert.equal(Rp.formatAgo(1000, 200000, 1000 + 200000 + 20000), 'just now');
assert.equal(Rp.formatAgo(1000, 3600000, 1000 + 3600000 + 7500000), '2 h 5 min ago');
assert.equal(Rp.formatAgo('', 0, 150000), '');
assert.equal(Rp.clampVolume(70), 70);
assert.equal(Rp.clampVolume(200), 130);
assert.equal(Rp.clampVolume(-5), 0);
assert.equal(Rp.clampVolume('bogus'), 70);
assert.equal(Rp.volumeFor({0: 80}, 0, 70), 80);
assert.equal(Rp.volumeFor({'1': 55}, 1, 70), 55);
assert.equal(Rp.volumeFor({}, 2, 70), 70);
assert.equal(Rp.volumeFor(null, 0, 70), 70);
assert.equal(Rp.volumeFor({0: 999}, 0, 70), 130);
assert.equal(Rp.qualityForStation({0: 'aac-320'}, 0, 'aac-128'), 'aac-320');
assert.equal(Rp.qualityForStation({42: 'aac-320'}, 42, 'aac-64'), 'aac-64');
assert.equal(Rp.qualityForStation({}, 1, 'mp3-192'), 'mp3-192');
assert.equal(Rp.qualityForStation(null, 0, 'aac-128'), 'aac-128');
assert.equal(Rp.largeCoverUrl('https://img.radioparadise.com/covers/m/10141.jpg'), 'https://img.radioparadise.com/covers/l/10141.jpg');
assert.equal(Rp.largeCoverUrl('https://img.radioparadise.com/covers/s/2.jpg'), 'https://img.radioparadise.com/covers/l/2.jpg');
assert.equal(Rp.largeCoverUrl('https://evil.com/x.jpg'), '');
assert.equal(Rp.largeCoverUrl(''), '');
assert.equal(Rp.largeArtTmpPath('https://img.radioparadise.com/covers/m/10141.jpg'), '/tmp/rpbar-large-10141.jpg');
assert.equal(Rp.largeArtTmpPath('https://evil.com/x.jpg'), '');
assert.equal(Rp.sleepLabel(Date.now() + 12 * 60000, Date.now()), '12 min left');
assert.equal(Rp.sleepLabel(0, Date.now()), '');
assert.equal(Rp.sleepLabel(Date.now() - 60000, Date.now()), '');
assert.equal(Rp.sleepMins(Date.now() + 12 * 60000, Date.now()), 12);
assert.equal(Rp.sleepMins(0, Date.now()), 0);
assert.equal(Rp.sleepMins(Date.now() - 1000, Date.now()), 0);
console.log('RpLogic tests ok');
"
echo "check ok"
