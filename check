#!/bin/bash
# rpbar check: format, lint, pure-logic tests. Run before every commit.
set -euo pipefail
cd "$(dirname "$0")"

qmlformat -i BarWidget.qml Service.qml
qmllint -I "$OMARCHY_PATH/shell" BarWidget.qml Service.qml
node --check RpLogic.js
node --input-type=module -e "
import fs from 'fs';
import assert from 'node:assert/strict';
const src = fs.readFileSync('RpLogic.js', 'utf8');
const Rp = new Function(src + '; return {stations,stationByChan,stepChan,streamUrl,splitArtistTitle,sanitizeText,notifySafe,coverId,isAllowedImageUrl,defaultQuality,stationShort,pillText,qualitiesFor,defaultQualityFor,qualityOrDefault,qualityNote,playerPageUrl,isAllowedLinkUrl};')();
assert.equal(Rp.stations().length, 7);
assert.equal(Rp.streamUrl(0), 'https://stream.radioparadise.com/aac-128');
assert.equal(Rp.streamUrl(1), 'https://stream.radioparadise.com/mellow-128');
assert.equal(Rp.streamUrl(42), 'https://stream.radioparadise.com/serenity');
assert.equal(Rp.streamUrl(945), 'https://stream.radioparadise.com/kfat-128');
assert.deepEqual(Rp.splitArtistTitle('A - T'), {artist: 'A', title: 'T'});
assert.deepEqual(Rp.splitArtistTitle('Solo'), {artist: '', title: 'Solo'});
assert.equal(Rp.sanitizeText(String.fromCharCode(97, 0, 98, 8238, 99)), 'abc');
assert.equal(Rp.notifySafe('a<b>i</b> -> c', 64), 'ab>i/b> -> c');
assert.equal(Rp.coverId('https://img.radioparadise.com/covers/m/11697.jpg'), '11697');
assert.equal(Rp.coverId('https://img.radioparadise.com/covers/s/1.jpg'), '1');
assert.equal(Rp.coverId('https://evil.com/covers/m/11697.jpg'), '');
assert.equal(Rp.coverId('https://img.radioparadise.com/covers/m/../x.jpg'), '');
assert.equal(Rp.stepChan(0, 1), 1);
assert.equal(Rp.stepChan(945, 1), 0);
assert.equal(Rp.stepChan(0, -1), 945);
assert.equal(Rp.stepChan(999, 1), 0);
assert.equal(Rp.stationShort(0), 'MM');
assert.equal(Rp.stationShort(1), 'ML');
assert.equal(Rp.stationShort(2), 'R');
assert.equal(Rp.stationShort(3), 'G');
assert.equal(Rp.stationShort(5), 'B');
assert.equal(Rp.stationShort(42), 'S');
assert.equal(Rp.stationShort(945), 'K');
assert.equal(Rp.stationShort(999), 'RP');
assert.equal(Rp.pillText(0, 'Talk Talk', 'Eden'), 'MM: Talk Talk - Eden');
assert.equal(Rp.pillText(1, '', 'Solo'), 'ML: Solo');
assert.equal(Rp.pillText(0, '', ''), 'The Main Mix');
assert.equal(Rp.qualitiesFor(0).length, 4);
assert.equal(Rp.qualitiesFor(1).length, 4);
assert.equal(Rp.qualitiesFor(42).length, 2);
assert.equal(Rp.defaultQualityFor(42), 'aac-64');
assert.equal(Rp.defaultQualityFor(0), 'aac-128');
assert.equal(Rp.qualityOrDefault(0, 'aac-320'), 'aac-320');
assert.equal(Rp.qualityOrDefault(42, 'aac-320'), 'aac-64');
assert.equal(Rp.qualityOrDefault(1, 'bogus'), 'aac-128');
assert.equal(Rp.streamUrl(0, 'aac-320'), 'https://stream.radioparadise.com/aac-320');
assert.equal(Rp.streamUrl(0, 'mp3-192'), 'https://stream.radioparadise.com/mp3-192');
assert.equal(Rp.streamUrl(0, 'flacm'), 'https://stream.radioparadise.com/flacm');
assert.equal(Rp.streamUrl(1, 'aac-320'), 'https://stream.radioparadise.com/mellow-320');
assert.equal(Rp.streamUrl(1, 'mp3-192'), 'https://stream.radioparadise.com/mellow-192');
assert.equal(Rp.streamUrl(1, 'flacm'), 'https://stream.radioparadise.com/mellow-flacm');
assert.equal(Rp.streamUrl(42, 'flac'), 'https://stream.radioparadise.com/serenity-flac');
assert.equal(Rp.streamUrl(42, 'aac-320'), 'https://stream.radioparadise.com/serenity');
assert.equal(Rp.qualityNote(42), 'Serenity offers 64k AAC and FLAC only.');
assert.equal(Rp.qualityNote(0), 'FLAC+ carries track titles; plain FLAC is not offered.');
assert.equal(Rp.playerPageUrl(0), 'https://radioparadise.com/player/info/main-mix');
assert.equal(Rp.playerPageUrl(1), 'https://radioparadise.com/player/info/mellow');
assert.equal(Rp.playerPageUrl(2), 'https://radioparadise.com/player/info/rock');
assert.equal(Rp.playerPageUrl(3), 'https://radioparadise.com/player/info/global');
assert.equal(Rp.playerPageUrl(5), 'https://radioparadise.com/player/info/beyond');
assert.equal(Rp.playerPageUrl(42), 'https://radioparadise.com/player/info/serenity');
assert.equal(Rp.playerPageUrl(945), 'https://radioparadise.com/player/info/kfat');
assert.equal(Rp.playerPageUrl(999), 'https://radioparadise.com/player/info/main-mix');
assert.equal(Rp.isAllowedLinkUrl('https://radioparadise.com/player/info/rock'), true);
assert.equal(Rp.isAllowedLinkUrl('https://www.radioparadise.com/player/info/rock'), true);
assert.equal(Rp.isAllowedLinkUrl('http://radioparadise.com/player/info/rock'), false);
assert.equal(Rp.isAllowedLinkUrl('https://radioparadise.com.evil.com/x'), false);
assert.equal(Rp.isAllowedLinkUrl('https://img.radioparadise.com/covers/m/1.jpg'), false);
assert.equal(Rp.isAllowedImageUrl('https://img.radioparadise.com/covers/l/1.jpg'), true);
assert.equal(Rp.isAllowedImageUrl('http://img.radioparadise.com/x.jpg'), false);
assert.equal(Rp.isAllowedImageUrl('https://img.radioparadise.com.evil.com/x'), false);
console.log('RpLogic tests ok');
"
echo "check ok"
